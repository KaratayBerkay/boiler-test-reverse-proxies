# pxlab reference configuration for Apache Traffic Server 9.2 - records.config (9.x format; 10.x uses records.yaml).
# Annotated walkthrough: docs/configs/ats.md.
CONFIG proxy.config.http.server_ports STRING 80 8080 8082:pp 8443:ssl 8444:ssl 8445:ssl
CONFIG proxy.config.exec_thread.autoconfig INT 0
CONFIG proxy.config.exec_thread.limit INT 4
CONFIG proxy.config.reverse_proxy.enabled INT 1
CONFIG proxy.config.url_remap.remap_required INT 1
CONFIG proxy.config.url_remap.pristine_host_hdr INT 1
CONFIG proxy.config.http.insert_squid_x_forwarded_for INT 1
CONFIG proxy.config.http.insert_request_via_str INT 1
CONFIG proxy.config.http.insert_response_via_str INT 2
CONFIG proxy.config.http.response_server_str STRING ats
CONFIG proxy.config.http.proxy_protocol_allowlist STRING 10.77.0.0/24,127.0.0.1
# --- timeouts / keep-alive / connection reuse
CONFIG proxy.config.http.connect_attempts_timeout INT 3
CONFIG proxy.config.http.connect_attempts_max_retries INT 2
CONFIG proxy.config.http.connect_attempts_rr_retries INT 2
# NextHop strategies mark a failed host down for parent_proxy.retry_time (default 300 s): a restarted backend stayed out of
# rotation for the whole chaos window. Re-try it after 5 s.
CONFIG proxy.config.http.parent_proxy.retry_time INT 5
CONFIG proxy.config.http.transaction_no_activity_timeout_out INT 30
CONFIG proxy.config.http.transaction_no_activity_timeout_in INT 60
CONFIG proxy.config.http.keep_alive_no_activity_timeout_in INT 75
CONFIG proxy.config.http.keep_alive_no_activity_timeout_out INT 60
CONFIG proxy.config.http.server_session_sharing.pool STRING thread
CONFIG proxy.config.http.server_session_sharing.match STRING both
CONFIG proxy.config.http.per_server.connection.max INT 20000
CONFIG proxy.config.net.connections_throttle INT 60000
# --- cache (RAM only for the lab)
CONFIG proxy.config.http.cache.http INT 1
CONFIG proxy.config.http.cache.required_headers INT 2
CONFIG proxy.config.http.cache.ignore_client_cc_max_age INT 1
CONFIG proxy.config.http.negative_revalidating_enabled INT 1
CONFIG proxy.config.http.negative_revalidating_lifetime INT 300
CONFIG proxy.config.cache.ram_cache.size INT 268435456
CONFIG proxy.config.http.cache.cache_responses_to_cookies INT 1
# Concurrent requests for ONE URL that is being fetched serialize on the cache: readers wait for the writer with the
# read-while-writer retry delay (50 ms!) and then the open-read retry time (10 ms) - 2k rps and a 60 ms p90 on /small
# with 64 connections, 29k rps with distinct URLs. Poll every millisecond instead (cache probes still pass):
CONFIG proxy.config.cache.read_while_writer_retry.delay INT 1
CONFIG proxy.config.http.cache.open_read_retry_time INT 1
CONFIG proxy.config.http.push_method_enabled INT 0
# --- TLS (server side)
CONFIG proxy.config.ssl.server.cert.path STRING /certs
CONFIG proxy.config.ssl.server.private_key.path STRING /certs
CONFIG proxy.config.ssl.CA.cert.path STRING /certs
CONFIG proxy.config.ssl.CA.cert.filename STRING ca.crt
CONFIG proxy.config.ssl.server.multicert.filename STRING ssl_multicert.config
CONFIG proxy.config.ssl.TLSv1 INT 0
CONFIG proxy.config.ssl.TLSv1_1 INT 0
CONFIG proxy.config.ssl.TLSv1_2 INT 1
CONFIG proxy.config.ssl.TLSv1_3 INT 1
CONFIG proxy.config.ssl.server.session_ticket.enable INT 0
CONFIG proxy.config.http2.max_concurrent_streams_in INT 256
# --- TLS (client side, to origins): verify the lab CA, SNI = origin host
CONFIG proxy.config.ssl.client.verify.server.policy STRING ENFORCED
CONFIG proxy.config.ssl.client.verify.server.properties STRING ALL
CONFIG proxy.config.ssl.client.CA.cert.path STRING /certs
CONFIG proxy.config.ssl.client.CA.cert.filename STRING ca.crt
CONFIG proxy.config.ssl.client.sni_policy STRING remap
CONFIG proxy.config.http.connect_ports STRING 443 563 8443
# --- logging / diagnostics to stdout / stderr
CONFIG proxy.config.log.logging_enabled INT 3
CONFIG proxy.config.log.max_secs_per_buffer INT 1
CONFIG proxy.config.diags.logfile.filename STRING stderr
CONFIG proxy.config.error.logfile.filename STRING stderr
CONFIG proxy.config.diags.debug.enabled INT 0
CONFIG proxy.config.diags.debug.tags STRING http|dns
CONFIG proxy.config.admin.user_id STRING trafficserver
CONFIG proxy.config.body_factory.template_sets_dir STRING /etc/trafficserver/body_factory
CONFIG proxy.config.http.enable_http_stats INT 1
